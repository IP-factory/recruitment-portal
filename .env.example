# Environment variables for the Recruitment Portal
#
# Copy this file to `.env` and supply real values for your environment.
# Do NOT commit `.env` to source control — only `.env.example` is tracked.
#
# Required for deployment:
#   DATABASE_URL
#
# Optional (with sane defaults):
#   NODE_ENV, PORT
#
# Optional (Manus OAuth — only when using the native OAuth callback):
#   OAUTH_PORTAL_URL, OAUTH_TOKEN_URL, OAUTH_CLIENT_SECRET, APP_ID
#
# Provisioning-time only (never stored):
#   ADMIN_PASSWORD, ADMIN_EMAIL, ADMIN_FULL_NAME  (see scripts/provision-task24b-admin.ts)

# ── Required ──────────────────────────────────────────────────────────────────
# TiDB/MySQL connection URL, e.g.:
#   mysql://<user>:<password>@<host>:<port>/<database>?ssl={"rejectUnauthorized":true}
DATABASE_URL=

# ── Optional with defaults ────────────────────────────────────────────────────
# NODE_ENV          = development | production  (default: development)
# PORT              = Express listen port       (default: 3100)

# ── Manus OAuth (optional) ───────────────────────────────────────────────────
# OAUTH_PORTAL_URL  = Manus OAuth portal base URL
# OAUTH_TOKEN_URL   = token endpoint (defaults to OAUTH_PORTAL_URL/token)
# OAUTH_CLIENT_SECRET
# APP_ID            = Manus application id

# ── Reverse proxy (production HTTPS) ─────────────────────────────────────────
# TRUST_PROXY       = set to 1 (or true) behind a TLS-terminating proxy so
#                     Express honours X-Forwarded-Proto and sends Secure cookies.
#                     Leave unset in local HTTP development.
